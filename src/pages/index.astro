---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import FeedGrid from '../components/FeedGrid.astro';
import Button from '../components/Button.astro';
import Tag from '../components/Tag.astro';
import { getLatest, getFeatured } from '../data/content';

// The homepage "Latest" samples the newest hand-maintained items (live list
// only, not link entries). "Best work" is the hand-ordered featured showcase.
const latest = getLatest(6);
const featuredEntries = await getCollection('featured');
const featuredItems = getFeatured(featuredEntries);
---

<Base>
  <!-- HERO -->
  <section class="hero-glow relative overflow-hidden">
    <div class="mx-auto max-w-6xl px-5 pb-12 pt-20 sm:pt-28">
      <div class="flex flex-col-reverse gap-10 lg:flex-row lg:items-center lg:gap-14">
        <div class="flex-1">
          <p class="animate-in mb-4 font-mono text-sm tracking-wide" style="color: var(--color-accent); animation-delay: 0.05s">
            Hi, I'm Alex.
          </p>
          <h1
            class="animate-in font-bold tracking-tight"
            style="font-size: var(--text-hero); line-height: var(--text-hero--line-height); animation-delay: 0.12s"
          >
            I build, teach,<br />
            and create for<br />
            <span class="text-gradient">developers.</span>
          </h1>
          <p class="animate-in mt-6 max-w-2xl text-lg" style="color: var(--fg-muted); animation-delay: 0.2s">
            Software engineer turned developer advocate. Five years creating content on MuleSoft,
            AI, DataWeave, and building with Claude. Videos, articles, livestreams, and open source.
          </p>
          <div class="animate-in mt-8 flex flex-wrap items-center gap-3" style="animation-delay: 0.28s">
            <Button href="/portfolio">See my portfolio</Button>
          </div>
          <div class="animate-in mt-6 flex flex-wrap gap-2" style="animation-delay: 0.36s">
            <Tag label="MuleSoft" />
            <Tag label="AI" />
            <Tag label="DataWeave" />
            <Tag label="Vibe coding" />
            <Tag label="Claude" />
          </div>
        </div>
        <div class="animate-pop w-full max-w-xs shrink-0 lg:max-w-sm" style="animation-delay: 0.15s">
          <div class="gradient-frame overflow-hidden rounded-[var(--radius-card)]">
          <img
            src="/alex.png"
            alt="Alex Martinez"
            width="800"
            height="800"
            decoding="async"
            class="aspect-square h-full w-full object-cover"
          />
          </div>
        </div>
      </div>
    </div>
  </section>

  <hr class="gradient-divider mx-auto max-w-6xl" />

  <!-- FEATURED -->
  {
    featuredItems.length > 0 && (
      <Section eyebrow="Featured" title="Best work">
        <FeedGrid items={featuredItems} featured />
      </Section>
    )
  }

  <!-- LATEST (live feeds) -->
  <Section eyebrow="Recent" title="Latest" href="/portfolio" hrefLabel="All content">
    <FeedGrid
      items={latest}
      emptyMessage="Latest videos, repos, and articles will appear here."
    />
  </Section>
</Base>
